# --- Database ---
# Local dev (default): SQLite
DATABASE_URL=sqlite:///./sentinelai.db
# Supabase Postgres (use the connection string from Project Settings > Database).
# "postgresql://" is rewritten to "postgresql+psycopg://" automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- LLM providers ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EXTERNAL_API_BASE_URL=https://api.openai.com/v1
EXTERNAL_API_KEY=
EXTERNAL_API_MODEL=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable. Losing it makes database-stored provider keys unreadable.
SECRET_ENCRYPTION_KEY=

# --- Run behaviour ---
REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=5
LLM_RETRY_BACKOFF_SECONDS=2.0
MAX_CONCURRENT_RUNS=2

# --- API ---
SUPABASE_URL=https://pkkqopmwlfarbbzomsvf.supabase.co
# Required only when your Supabase project still signs access tokens with HS256.
# Get the legacy JWT secret from Supabase Project Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_USER_ID=local-dev
